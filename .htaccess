Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

ErrorDocument 404 /nh_hor/errors/404.php
ErrorDocument 500 /nh_hor/errors/500.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # thiele-nachhilfe.de ist eine Weiterleitungsdomain.
  # Alle Aufrufe innerhalb /nh_hor werden auf die kanonische Domain übertragen.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?thiele-nachhilfe\.de$ [NC]
  RewriteRule ^ https://easyit-nachhilfe.de%{REQUEST_URI} [R=301,L,NE]

  # Auf der öffentlichen Hauptdomain HTTPS und die Variante ohne www erzwingen.
  RewriteCond %{HTTP_HOST} ^www\.easyit-nachhilfe\.de$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(?:www\.)?easyit-nachhilfe\.de$ [NC]
  RewriteRule ^ https://easyit-nachhilfe.de%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/avif "access plus 90 days"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header set Cache-Control "public, max-age=2592000" "expr=%{CONTENT_TYPE} =~ m#^(text/css|application/javascript|image/)#"
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)|README\.md|config)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteRule ^storage/ - [F,L]
  RewriteRule ^database/ - [F,L]
  RewriteRule ^cache/ - [F,L]
</IfModule>
