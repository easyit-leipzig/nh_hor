Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dynamische XML-Sitemap aus indexierbaren Seiten und veröffentlichten Blogartikeln.
  RewriteRule ^sitemap\.xml$ sitemap-xml.php [END]

  # Lokaler Betrieb:
  # http://localhost/nh_hor -> htdocs/nh_hor
  # niemals auf Produktionsdomain umleiten.
  #
  # Die nh_hor-Weiterleitung wurde entfernt, da sie lokal
  # den Entwicklungsstand überschreiben würde.


  # Alle Zugangsdomains auf die einzige kanonische Domain umleiten.
  # Separate Domains bleiben erhalten.
  # Keine automatische Umleitung von easyit-nachhilfe.de.

  # Doppelte Startseiten-URL vermeiden: /index.php wird auf / kanonisiert.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?easyit-leipzig\.de$ [NC]
  RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
  RewriteRule ^index\.php$ https://easyit-leipzig.de/ [R=301,L,NE]

  # Hauptdomain: HTTPS und Variante ohne www erzwingen.
  RewriteCond %{HTTP_HOST} ^www\.easyit-leipzig\.de$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(?:www\.)?easyit-leipzig\.de$ [NC]
  RewriteRule ^ https://easyit-leipzig.de%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^storage/ - [F,L]
  RewriteRule ^database/ - [F,L]
  RewriteRule ^config/ - [F,L]
  RewriteRule ^_project_archive/ - [F,L]
  RewriteRule ^easyIT_Relaunch_Startseite_01-09-2026/ - [F,L]
  RewriteRule ^tools/(?:tools\.md)?$ - [F,L,NC]
  RewriteRule ^cache/ - [F,L]

  # Entwicklungs-, Archiv-, Dump- und temporäre Verzeichnisse sperren.
  RewriteRule ^(?:backup|backups|archive|archives|dump|dumps|temp|tmp)(?:/|$) - [F,L,NC]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Nicht versionierte Ressourcen nur kurz zwischenspeichern.
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Ein Jahr und immutable ausschließlich für Content-Hash-Dateien.
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#\.[0-9a-f]{12}\.(?:css|js)$#"

  # Nicht versionierte CSS-/JS-Dateien, insbesondere der Service Worker,
  # müssen bei jeder Aktualisierung revalidiert werden.
  Header set Cache-Control "no-cache, max-age=0, must-revalidate" "expr=%{REQUEST_URI} =~ m#\.(?:css|js)$# && %{REQUEST_URI} !~ m#\.[0-9a-f]{12}\.(?:css|js)$#"
  Header set Service-Worker-Allowed "/" "expr=%{REQUEST_URI} =~ m#/service-worker\.js$#"
</IfModule>

# Quell-, Konfigurations-, Datenbank-, Archiv-, Backup- und Projektdateien nie ausliefern.
<FilesMatch "(?i)(^\.|(?:^|\.)(?:env|ini|log|sql|sqlite|sqlite3|zip|7z|rar|tar|gz|tgz|bz2|xz|md|markdown|ppj|bak|backup|old|orig|save|swp|tmp|temp|dist|example|lock|yml|yaml|csv)$|composer\.(?:json|lock)$|README(?:[^/]*)$)">
  Require all denied
</FilesMatch>


# PHP-Ausführung in öffentlich beschreibbaren Uploadpfaden unterbinden.
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]
</IfModule>
