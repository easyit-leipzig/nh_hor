APP_ENV=production
# Optional: absolutes Verzeichnis außerhalb des Webroots
EASYIT_CONFIG_DIR=/vollstaendiger/serverpfad/easyit-config

SITE_BASE_URL=https://easyit-leipzig.de
SITE_OWNER=Olaf Thiele
SITE_PHONE=
SITE_EMAIL=
SITE_STREET=
SITE_POSTAL_CODE=
SITE_CITY=Leipzig
SITE_REGION=Sachsen
SITE_COUNTRY=DE

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Alternativ vollständig: DB_DSN=mysql:host=localhost;dbname=...;charset=utf8mb4

MAIL_ENABLED=false
MAIL_RECIPIENT=
MAIL_SENDER=
MAIL_SENDER_NAME=easyIT Website

# Content Security Policy: report-only, enforce oder off
CSP_MODE=report-only

# Contact SMTP
MAIL_ENABLED=true
MAIL_RECIPIENT=info@example.org
MAIL_SENDER=website@example.org
MAIL_SENDER_NAME=easyIT Website
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=website@example.org
SMTP_PASSWORD=replace-me
SMTP_TIMEOUT=15
CONTACT_LOG_RETENTION_DAYS=30
